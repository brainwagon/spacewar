# PDP-1 simulator. Track authored source only.
#
# Strategy: ignore everything by default, then re-include source files. Any
# generated or derived file is therefore ignored automatically. The section
# at the bottom names the generated files explicitly so the intent is clear
# and so they stay ignored if the allowlist is ever relaxed.

*

# allow directory traversal
!*/

# ---- authored source ----
!*.c
!*.h
!*.pl
!*.py
!Makefile
!Makefile.*
!README.md
!.gitignore

# ---- generated / derived files (explicit) ----
# compiled binaries and objects
*.o
*.a
a.out
pdp1
spacewar
pdp1dump
pdp1_mul_test
pdp1_snowflake_test
core
*.core

# data headers generated from paper-tape / bitmap images
spacewar.mem.h
snowflake.h
snowflake2.h

# tape images and assembler listings produced by the toolchain
spacewar.bin
*.lst

# editor and version backups
*.orig
*.sav
*.bak
*~
*.dsp
*.dsw

# generated media and archives
*.mp4
*.mpg
*.gif
*.pdf
*.zip
